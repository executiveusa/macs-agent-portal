# Human auth
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
STACY_ALLOWED_EMAILS=
CONTROL_TOWER_ALLOWED_ORIGINS=

# Separate machine/runtime credentials; generate a unique random value for each.
MAXX_API_KEY=
MAXX_HERMES_API_KEY=
NCA_TOOLKIT_API_KEY=
MAXX_SANDBOX_KEY=

# Optional scoped event bridge for email/calendar/CRM/webhook triggers.
# The event key may authenticate only POST /v1/events and is bound to one operator UUID.
MAXX_EVENT_INGEST_KEY=
MAXX_EVENT_OPERATOR_ID=

# Optional scoped Hermes MCP bridge. Use a distinct random key. The tool bridge
# may call only the explicitly bounded Pup/workflow/refinement/sandbox routes
# allowed by auth.ts. It never receives MAXX_SANDBOX_KEY directly.
MAXX_HERMES_TOOL_KEY=
MAXX_HERMES_TOOL_OPERATOR_ID=

# Cloudflare split deployment. Leave blank when using the legacy/direct VPS edge.
# For cloudflare-split, this token belongs only on the VPS/runtime side and must
# never be exposed through VITE_* frontend variables.
CLOUDFLARE_TUNNEL_TOKEN=

# Optional private networking for VPS/admin access. Prefer a tagged/one-off key.
# This does not replace public customer ingress and Flywheel never enables Funnel.
MAXX_TAILSCALE_AUTH_KEY=
MAXX_TAILSCALE_HOSTNAME=maxx-vps
MAXX_TAILSCALE_TAGS=
MAXX_TAILSCALE_SSH=false

# Optional. deploy/maxx/install.sh generates a local image name from
# services/hermes-runtime/UPSTREAM.lock when this is blank. Set this only when
# your deployment factory has already built/published that exact locked revision.
MAXX_HERMES_IMAGE=

# Hermes providers: configure only what this deployment is allowed to use.
OPENROUTER_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
GOOGLE_API_KEY=
DASHSCOPE_API_KEY=
KIMI_API_KEY=
XAI_API_KEY=

# Optional connected-app surfaces. Each stays parked unless its key exists.
COMPOSIO_CONSUMER_KEY=
LATITUDE_API_KEY=
AGENTMAIL_API_KEY=

# Future/approval-sensitive integrations remain disabled until separately reviewed.
AGENTPHONE_API_KEY=
OP_SERVICE_ACCOUNT_TOKEN=

# Optional model tiers. Provider+model must both be set for a tier to activate.
MAXX_HERMES_FAST_PROVIDER=
MAXX_HERMES_FAST_MODEL=
MAXX_HERMES_STANDARD_PROVIDER=
MAXX_HERMES_STANDARD_MODEL=
MAXX_HERMES_POWER_PROVIDER=
MAXX_HERMES_POWER_MODEL=

# Optional product capabilities
MAXX_VOICE_ENABLED=false
MAXX_BROWSER_ENABLED=false
MAXX_BROWSER_MUTATIONS_ENABLED=false
MAXX_MEMORY_ENABLED=true
MAXX_SCHEDULER_ENABLED=true

# Bounded Pup run timeout passed into Hermes. 900000 ms = 15 minutes.
MAXX_PUP_RUN_TIMEOUT_MS=900000

# Sovereign MAXX Sandbox sizing.
MAXX_SANDBOX_MAX_EXEC_SECONDS=120
MAXX_SANDBOX_MAX_OUTPUT_BYTES=100000
MAXX_SANDBOX_MEMORY_LIMIT=2g
MAXX_SANDBOX_CPU_LIMIT=2.0

# Media worker sizing
NCA_MAX_QUEUE_LENGTH=10
NCA_GUNICORN_WORKERS=2
NCA_GUNICORN_TIMEOUT=600
