NODE_ENV=production
HOST=0.0.0.0
PORT=8787

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
STACY_ALLOWED_EMAILS=

# Machine-to-machine credential for MAXX CLI/MCP/agent clients. Generate a
# deployment-specific random value; never expose it to browser JavaScript.
MAXX_API_KEY=

OPENROUTER_API_KEY=
FIRECRAWL_API_KEY=
OPUSCLIP_API_KEY=

MAXX_ICM_ROOT=/data/maxx
PI_EXECUTABLE=
MAXX_BROWSER_WS_ENDPOINT=
MAXX_BROWSER_EXECUTABLE_PATH=
CONTROL_TOWER_ALLOWED_ORIGINS=https://your-private-agent-maxx-domain.example

MAXX_STT_ENDPOINT=
MAXX_STT_API_KEY=
MAXX_TTS_ENDPOINT=
MAXX_TTS_API_KEY=

# Safe rollout flags. Vision is architected now but remains optional until the
# Android/Meta-glasses companion and vision gateway are independently verified.
MAXX_HERMES_ENABLED=false
MAXX_VOICE_ENABLED=false
MAXX_VISION_ENABLED=false
MAXX_BROWSER_ENABLED=false
MAXX_BROWSER_MUTATIONS_ENABLED=false
MAXX_MEMORY_ENABLED=false
MAXX_SCHEDULER_ENABLED=false

MAXX_PRODUCTION_MUTATIONS_ENABLED=false
MAXX_EMERGENCY_DISABLE=false
MAXX_APPROVAL_TTL_HOURS=24

# Fresh MAXX Hermes instance only. Do not point these at Bambu's personal Hermes.
MAXX_HERMES_ENDPOINT=
MAXX_HERMES_API_KEY=

MAXX_MEMORY_INDEX_PATH=
